{
  "name": "ai-editor-studio",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "main": "electron-main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/patch-hyperframes.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && vite build && node scripts/build-server.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "app:dev": "npm run prepare:runtime && node scripts/prepare-pexels-bundle.mjs && npm run build && electron electron-main.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dist:win": "node scripts/require-platform.mjs win32 x64 && npm run prepare:runtime && node scripts/prepare-pexels-bundle.mjs && npm run build && electron-builder --win nsis --publish never",
    "setup:model": "node scripts/setup-model.mjs",
    "test:recipes": "tsx --no-cache --test scripts/test-recipes.ts scripts/test-amber.ts scripts/test-review-bds.ts",
    "dist:mac": "node scripts/require-platform.mjs darwin && npm run prepare:runtime && node scripts/prepare-pexels-bundle.mjs && npm run build && electron-builder --mac dmg --publish never",
    "test:platform": "node --test scripts/test-platform.mjs",
    "test:core-beats": "tsx --no-cache --test scripts/test-core-beats.ts",
    "postinstall": "node scripts/patch-hyperframes.mjs",
    "test:finals": "tsx --no-cache --test scripts/test-finals-stage.ts"
  },
  "dependencies": {
    "@openai/codex": "0.169.0",
    "@puppeteer/browsers": "3.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "busboy": "^1.6.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hyperframes": "0.8.159",
    "lucide-react": "^0.468.0",
    "puppeteer-core": "^25.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.igen.ai-editor-studio",
    "productName": "AI Editor Studio",
    "asar": false,
    "electronFuses": {
      "runAsNode": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron-main.mjs",
      "desktop/**/*",
      "vite.config.ts",
      "server/**/*",
      "ghost-editor/**/*",
      "assets/**/*",
      "public/**/*",
      "scripts/**/*",
      "package.json",
      "!**/*.tsbuildinfo",
      "!**/*.map",
      "!**/.cache/**",
      "!ghost-editor/docs/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "extraResources": [
      {
        "from": ".runtime/pexels-key",
        "to": "pexels-key"
      },
      {
        "from": ".runtime/${platform}-${arch}",
        "to": "runtime",
        "filter": [
          "node/**/*",
          "uv/**/*",
          "vc_redist.x64.exe",
          "target.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AI-Editor-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "minimumSystemVersion": "14.0",
      "artifactName": "AI-Editor-Studio-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
