{
  "name": "ai-editor-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron-main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "app:dev": "npm run build && electron electron-main.mjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "setup:model": "node scripts/setup-model.mjs",
    "test:recipes": "tsx --no-cache --test scripts/test-recipes.ts scripts/test-amber.ts"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hyperframes": "^0.8.159",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "puppeteer-core": "^25.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.igen.ai-editor-studio",
    "productName": "AI Editor Studio",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.mjs",
      "vite.config.ts",
      "server/**/*",
      "ghost-editor/**/*",
      "assets/**/*",
      "public/**/*",
      "scripts/**/*",
      "package.json",
      "!**/*.tsbuildinfo",
      "!**/*.map",
      "!**/.cache/**",
      "!ghost-editor/docs/**",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "AI-Editor-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
